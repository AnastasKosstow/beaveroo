---
import Default from '@astrojs/starlight/components/Sidebar.astro';
import HeaderLinks from './HeaderLinks.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="hf-course">
	<a class="hf-course__title" href={siteTitleHref}>
		<span class="hf-course__dot" aria-hidden="true"></span>
		<span>{Astro.locals.t('course.title')}</span>
	</a>
	<div class="hf-course__tools md:sl-hidden"><HeaderLinks /></div>
</div>

<Default><slot /></Default>
