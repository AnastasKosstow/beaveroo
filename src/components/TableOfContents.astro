---
import Default from '@astrojs/starlight/components/TableOfContents.astro';

const { toc, entry } = Astro.locals.starlightRoute;
if (toc && toc.items.length > 0) {
	toc.items[0] = { ...toc.items[0], text: entry.data.title };
}
const isLesson = !!entry.data.unit;
---

<div class:list={{ 'co-toc': isLesson }}><Default><slot /></Default></div>
