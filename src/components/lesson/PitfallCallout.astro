---
interface Props {
	title?: string;
}

const { title = Astro.locals.t('pitfall.title') } = Astro.props;
---

<aside class="co-callout co-callout--pitfall" aria-label={title}>
	<p class="co-callout__title">
		<span class="co-callout__icon" aria-hidden="true">⚠️</span>
		<span>{title}</span>
	</p>
	<div class="co-callout__body"><slot /></div>
</aside>
