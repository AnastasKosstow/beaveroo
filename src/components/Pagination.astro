---
const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const t = Astro.locals.t;
---

{
	(prev || next) && (
		<nav class="hf-pagination print:hidden" aria-label={t('pagination.label')}>
			{prev ? (
				<a class="hf-pagination__link" href={prev.href} rel="prev">
					<span class="hf-pagination__label">
						<span aria-hidden="true">←</span> {t('page.previousLink')}
					</span>
					<span class="hf-pagination__title">{prev.label}</span>
				</a>
			) : (
				<span />
			)}
			{next ? (
				<a class="hf-pagination__link" href={next.href} rel="next">
					<span class="hf-pagination__label">
						{t('page.nextLink')} <span aria-hidden="true">→</span>
					</span>
					<span class="hf-pagination__title">{next.label}</span>
				</a>
			) : (
				<span />
			)}
		</nav>
	)
}
