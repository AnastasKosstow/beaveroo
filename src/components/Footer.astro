---
import Default from '@astrojs/starlight/components/Footer.astro';
import { courseOf, slugOf } from '../courses';

const t = Astro.locals.t;
const { locale, id } = Astro.locals.starlightRoute;

// The link belongs to the courses adapted from Hugging Face. Pages outside a course keep it.
const course = courseOf(slugOf(id, locale));
const showHuggingFace = !course || course.huggingFace;
---

<Default><slot /></Default>

<div class="hf-footer">
	{
		showHuggingFace && (
			<a class="hf-footer__link" href="https://huggingface.co" target="_blank" rel="noopener">
				<img class="hf-footer__icon" src="/images/huggingface.svg" alt="" width="20" height="20" loading="lazy" />
				<span>{t('footer.huggingFace')}</span>
			</a>
		)
	}
	<a class="hf-footer__link" href="https://github.com/AnastasKosstow/beaveroo" target="_blank" rel="noopener">
		<span class="hf-footer__icon hf-footer__icon--emoji" aria-hidden="true">🦫</span>
		<span>{t('footer.sourceCode')}</span>
	</a>
</div>
